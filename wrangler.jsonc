{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wxh518-homepage-api",
	"account_id": "80fe6761429adbcb368c94c75dffdcac",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-13",
	"workers_dev": true,
	"preview_urls": false,
	"dev": {
		"ip": "127.0.0.1",
		"port": 8787
	},
	"vars": {
		"ALLOWED_ORIGINS": "https://wxh518.github.io,http://127.0.0.1:5173,http://localhost:5173"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wxh518-homepage-content",
			"database_id": "2a0cb3dc-2291-4a32-8b76-40393e7d7e32"
		}
	]
}