{
  "name": "orbit-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --local",
    "build": "npm run typecheck && vite build",
    "build:api": "wrangler deploy --dry-run --outdir worker-dist",
    "deploy:api": "wrangler deploy",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json",
    "test": "tsx --test tests/content-api.test.ts tests/http-content-service.test.ts"
  },
  "dependencies": {
    "@fontsource/coda": "^5.2.6",
    "hono": "^4.13.13",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "wrangler": "^4.150.0"
  }
}
